      "type": "integer",
      "maximum": 39.0,
      "minimum": 1.0,
      "title": "N Panels",
      "default": 19
     },
     "block": {
      "type": "integer",
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Block",
      "default": 12
     },
     "seed": {
      "type": "integer",
