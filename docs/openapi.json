      "title": "Alpha",
      "default": 0.05
     }
    },
    "type": "object",
    "required": [
     "file",
     "variable"
    ],
    "title": "Body_trendmap_upload_api_trendmap_upload_post"
   },
   "Body_upload_csv_api_timeseries_upload_csv_post": {
