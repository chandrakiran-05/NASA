 "components": {
  "schemas": {
   "AnalyzeRequest": {
    "properties": {
     "series_id": {
      "type": "string",
      "title": "Series Id"
     },
     "alpha": {
      "type": "number",
      "exclusiveMaximum": 0.5,
      "exclusiveMinimum": 0.0,
      "title": "Alpha",
      "default": 0.05
     },
     "deseasonalize": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "string",
        "enum": [
         "stl",
         "climatology",
         "none"
        ]
       }
      ],
      "title": "Deseasonalize",
      "default": true
     },
     "methods": {
      "items": {
       "type": "string",
       "enum": [
        "ols",
        "mk",
        "seasonal_mk",
        "sen"
       ]
      },
      "type": "array",
      "title": "Methods",
      "default": [
       "ols",
       "mk",
       "seasonal_mk",
       "sen"
      ]
     },
     "mk_variant": {
      "type": "string",
      "enum": [
       "auto",
       "ess_ar1",
       "original",
       "hamed_rao",
       "yue_wang",
       "tfpw"
      ],
      "title": "Mk Variant",
      "default": "auto"
     },
     "include_series": {
      "type": "boolean",
      "title": "Include Series",
      "default": true
     },
     "include_court": {
      "type": "boolean",
      "title": "Include Court",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "series_id"
    ],
    "title": "AnalyzeRequest"
   },
   "Body_trendmap_upload_api_trendmap_upload_post": {
    "properties": {
