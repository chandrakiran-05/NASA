# ---- NASA Earthdata Login (free: https://urs.earthdata.nasa.gov) ----
# Bearer token (valid 60 days; max 2 active). Profile -> Generate Token. Used by Giovanni, Harmony, Cloud OPeNDAP.
EARTHDATA_TOKEN=
# Username/password: AppEEARS /login (or put them in ~/.netrc: machine urs.earthdata.nasa.gov login .. password ..)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ---- NOAA CDO token (free: https://www.ncdc.noaa.gov/cdo-web/token) - only for station discovery / fallback ----
NOAA_CDO_TOKEN=

# ---- Offline AI (local only) ----
# ollama | openai (any OpenAI-compatible local server: llama.cpp, LM Studio, vLLM) | none
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
# alternatives: gemma4:e4b, phi4-mini  (pull with: ollama pull <model>)

# Optional deep-review tier (AirLLM): a 14B+ model run layer by layer from disk. Every new token re-reads
# all layers, so expect seconds (14B) to tens of seconds (70B) PER TOKEN: background jobs only, short JSON,
# advisory (never decides a verdict). Setup: pip install -r requirements-airllm.txt; python scripts/airllm_setup.py
# DEEP_LLM_PROVIDER=none          # none | airllm
# DEEP_LLM_MODEL=                 # empty = the model airllm_setup.py recommends for this machine
# DEEP_LLM_COMPRESSION=4bit       # 4bit | 8bit | none
# DEEP_LLM_MAX_NEW_TOKENS=64
# DEEP_LLM_LAYER_DIR=             # where split layers go (default: next to the Hugging Face cache)
# DEEP_LLM_TIMEOUT_S=1800

# ---- Service ----
# DATA_DIR=./data
# CORS_ORIGINS=["http://localhost:5173"]
# MIN_MONTHS_FOR_TEST=120
# MIN_VALID_FRACTION_PER_MONTH=0.7

# ---- Research Evidence (live literature: arXiv, OpenAlex, Springer Nature) ----
RESEARCH_ENABLED=true
# free key from https://dev.springernature.com/ (optional; arXiv + OpenAlex work without a key)
SPRINGER_API_KEY=
# Semantic Scholar works without a key but the shared pool is often rate-limited (free key recommended)
SEMANTIC_SCHOLAR_API_KEY=
# NASA ADS (Astrophysics Data System, includes Earth science) free token
ADS_API_TOKEN=
