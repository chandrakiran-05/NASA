      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Variable Id"
     },
     "geometry": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Geometry"
     },
     "start": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Start"
     },
     "end": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "End"
     },
     "insights": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Insights",
      "default": [
       "detectability",
       "emergence",
       "records",
       "breaks",
       "triangle",
       "forecast"
      ]
     },
     "explain": {
      "type": "boolean",
      "title": "Explain",
      "default": true
     },
     "max_regions": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Max Regions",
      "default": 3
     }
    },
    "type": "object",
    "title": "InvestigateRequest"
   },
   "NullsRequest": {
    "properties": {
